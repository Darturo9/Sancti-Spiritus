---
import EmergencyBar from './EmergencyBar.astro';

const navLinks = [
  { href: '#hero', label: 'Inicio', section: 'hero' },
  { href: '#about', label: 'Nosotros', section: 'about' },
  { href: '#services', label: 'Servicios', section: 'services' },
  { href: '#reviews', label: 'Testimonios', section: 'reviews' },
  { href: '#faq', label: 'FAQ', section: 'faq' },
  { href: '#contact', label: 'Contacto', section: 'contact' },
];
---

<EmergencyBar />

<header class="navbar" id="main-navbar">
  <div class="navbar-container">
    <a href="#" class="navbar-brand" aria-label="Hospital Clinico Quirurgico Sancti Spiritus - Inicio">
      <img src="/images/logo-nav.png" alt="Sancti Spiritus" class="navbar-logo" width="38" height="48" loading="eager" />
      <div class="navbar-brand-text">
        <span class="navbar-brand-name">Sancti Spiritus</span>
        <span class="navbar-brand-sub">Hospital Clinico Quirurgico</span>
      </div>
    </a>

    <nav class="navbar-nav" aria-label="Navegacion principal">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link" data-section={link.section}>{link.label}</a>
      ))}
    </nav>

    <button
      class="navbar-hamburger"
      id="menu-toggle"
      aria-label="Abrir menu de navegacion"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      type="button"
    >
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
    </button>
  </div>
</header>

<div class="drawer-overlay" id="drawer-overlay" aria-hidden="true"></div>

<nav class="mobile-drawer" id="mobile-drawer" aria-label="Menu de navegacion movil" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-brand">
      <img src="/images/logo-nav.png" alt="" class="drawer-logo" width="28" height="36" loading="lazy" aria-hidden="true" />
      <span>Sancti Spiritus</span>
    </div>
    <button class="drawer-close" id="menu-close" aria-label="Cerrar menu" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <ul class="drawer-nav" role="list">
      {navLinks.map(link => (
      <li>
        <a href={link.href} class="drawer-link" data-section={link.section}>{link.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 40px;
    left: 0;
    right: 0;
    z-index: 40;
    background-color: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e5e7eb;
    transition: box-shadow 0.3s ease;
  }
  .navbar.scrolled {
    box-shadow: 0 2px 24px rgba(0, 66, 104, 0.10);
  }
  .navbar-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    line-height: 1.2;
    text-decoration: none;
    flex-shrink: 0;
  }
  .navbar-logo {
    width: 38px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .navbar-brand-text {
    display: flex;
    flex-direction: column;
  }
  .navbar-brand-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #004268;
  }
  .navbar-brand-sub {
    font-size: 0.6875rem;
    font-weight: 400;
    color: #41474f;
  }
  .navbar-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-link {
    position: relative;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #41474f;
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s ease, background-color 0.2s ease;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .nav-link:hover {
    color: #004268;
    background-color: #f0f3ff;
  }
  .nav-link:focus-visible {
    outline: 2px solid #004268;
    outline-offset: 2px;
  }
  .nav-link.active {
    color: #004268;
    background-color: #f0f3ff;
  }
  .navbar-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 10px;
    transition: background-color 0.2s ease;
  }
  .navbar-hamburger:hover { background-color: #f0f3ff; }
  .navbar-hamburger:focus-visible {
    outline: 2px solid #004268;
    outline-offset: 2px;
  }
  .ham-bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #001d32;
    border-radius: 2px;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }
  .navbar-hamburger[aria-expanded="true"] .ham-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .navbar-hamburger[aria-expanded="true"] .ham-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .navbar-hamburger[aria-expanded="true"] .ham-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 49;
    background-color: rgba(0, 11, 54, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .drawer-overlay.open {
    display: block;
    opacity: 1;
  }
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: min(320px, 85vw);
    background-color: #ffffff;
    box-shadow: -4px 0 32px rgba(0, 11, 54, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }
  .mobile-drawer.open { transform: translateX(0); }
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid #e5e7eb;
  }
  .drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #004268;
  }
  .drawer-logo {
    width: 28px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #41474f;
    border-radius: 10px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .drawer-close:hover { background-color: #f0f3ff; color: #001d32; }
  .drawer-close:focus-visible { outline: 2px solid #004268; outline-offset: 2px; }
  .drawer-nav {
    list-style: none;
    padding: 0.75rem 0;
    margin: 0;
    flex: 1;
  }
  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: #001d32;
    text-decoration: none;
    min-height: 52px;
    transition: background-color 0.15s ease, color 0.15s ease;
    border-left: 3px solid transparent;
  }
  .drawer-link:hover {
    background-color: #f0f3ff;
    color: #004268;
    border-left-color: #004268;
  }
  .drawer-link:focus-visible { outline: 2px solid #004268; outline-offset: -2px; }

  @media (min-width: 768px) {
    .navbar-nav { display: flex; }
    .navbar-hamburger { display: none; }
  }
  @media (max-width: 767px) {
    .navbar-container { padding: 0 1rem; }
    .navbar-brand-sub { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer, .drawer-overlay, .ham-bar, .nav-link, .drawer-link { transition: none; }
  }
</style>

<script>
  const navbar = document.getElementById('main-navbar');
  const toggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const closeBtn = document.getElementById('menu-close');
  const drawerLinks = drawer?.querySelectorAll('.drawer-link');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
    drawer?.setAttribute('aria-hidden', 'false');
    overlay?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    drawer?.setAttribute('aria-hidden', 'true');
    overlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  drawerLinks?.forEach(link => link.addEventListener('click', closeDrawer));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) closeDrawer();
  });

  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 8);
  }, { passive: true });

  const allNavLinks = document.querySelectorAll('.nav-link[data-section]');
  const allDrawerLinks = document.querySelectorAll('.drawer-link[data-section]');

  function setActiveSection(sectionId: string) {
    const id = sectionId.replace('#', '');
    allNavLinks.forEach(l => l.classList.toggle('active', l.getAttribute('data-section') === id));
    allDrawerLinks.forEach(l => l.classList.toggle('active', l.getAttribute('data-section') === id));
  }

  const sections = document.querySelectorAll('section[id]');
  const sectionObserver = new IntersectionObserver((entries) => {
    let activeSection = '';
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        activeSection = entry.target.id;
      }
    });
    if (activeSection) {
      setActiveSection(activeSection);
      history.replaceState(null, '', `#${activeSection}`);
    }
  }, { threshold: 0.3, rootMargin: '-80px 0px -40% 0px' });

  sections.forEach(s => sectionObserver.observe(s));
</script>
