<div class="floating-wa" id="floating-wa">
  <div class="floating-wa-popover" id="floating-wa-popover" role="dialog" aria-label="Confirmar apertura de WhatsApp" aria-hidden="true" inert>
    <p class="floating-wa-popover-text">¿Deseas abrir WhatsApp para chatear con el hospital?</p>
    <div class="floating-wa-popover-actions">
      <button class="floating-wa-btn-cancel" id="floating-wa-cancel" type="button">Cancelar</button>
      <a
        class="floating-wa-btn-open"
        id="floating-wa-open"
        href="https://wa.me/50243036016"
        target="_blank"
        rel="noopener"
      >Abrir WhatsApp</a>
    </div>
  </div>
  <button
    class="floating-wa-trigger"
    id="floating-wa-trigger"
    aria-label="Chatear por WhatsApp"
    aria-expanded="false"
    aria-controls="floating-wa-popover"
    type="button"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </button>
</div>

<style>
  .floating-wa {
    position: fixed;
    bottom: 5.25rem;
    right: 1.5rem;
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .floating-wa-popover {
    background-color: #ffffff;
    border-radius: 0.75rem;
    padding: 1.25rem;
    box-shadow: 0 8px 32px rgba(0, 11, 54, 0.16);
    max-width: 260px;
    opacity: 0;
    transform: translateY(8px) scale(0.95);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .floating-wa-popover.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .floating-wa-popover-text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: #41474f;
    margin: 0 0 0.875rem;
  }

  .floating-wa-popover-actions {
    display: flex;
    gap: 0.5rem;
  }

  .floating-wa-btn-cancel {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: inherit;
    color: #717880;
    background: #f3f4f6;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .floating-wa-btn-cancel:hover {
    background-color: #e5e7eb;
  }
  .floating-wa-btn-cancel:focus-visible {
    outline: 2px solid #004268;
    outline-offset: 2px;
  }

  .floating-wa-btn-open {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: inherit;
    color: #ffffff;
    background-color: #25D366;
    border: none;
    border-radius: 0.5rem;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .floating-wa-btn-open:hover {
    background-color: #1ebe57;
  }
  .floating-wa-btn-open:focus-visible {
    outline: 2px solid #25D366;
    outline-offset: 2px;
  }

  .floating-wa-trigger {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #25D366;
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }
  .floating-wa-trigger:hover {
    background-color: #1ebe57;
    transform: scale(1.08);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.45);
  }
  .floating-wa-trigger:focus-visible {
    outline: 2px solid #25D366;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .floating-wa {
      bottom: 5rem;
      right: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-wa-popover,
    .floating-wa-trigger {
      transition: none;
    }
  }
</style>

<script>
  const trigger = document.getElementById('floating-wa-trigger') as HTMLButtonElement;
  const popover = document.getElementById('floating-wa-popover') as HTMLDivElement;
  const cancelBtn = document.getElementById('floating-wa-cancel') as HTMLButtonElement;

  function openPopover() {
    popover.classList.add('open');
    popover.setAttribute('aria-hidden', 'false');
    popover.removeAttribute('inert');
    trigger.setAttribute('aria-expanded', 'true');
  }

  function closePopover() {
    popover.classList.remove('open');
    popover.setAttribute('aria-hidden', 'true');
    popover.setAttribute('inert', '');
    trigger.setAttribute('aria-expanded', 'false');
  }

  trigger?.addEventListener('click', () => {
    if (popover.classList.contains('open')) {
      closePopover();
    } else {
      openPopover();
    }
  });

  cancelBtn?.addEventListener('click', closePopover);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popover?.classList.contains('open')) {
      closePopover();
      trigger?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (popover?.classList.contains('open') && !popover.contains(target) && target !== trigger) {
      closePopover();
    }
  });
</script>
