<section class="booking-section" id="booking">
  <div class="booking-container">
    <div class="booking-card">
      <h2 class="booking-heading">Solicita una Cita</h2>
      <p class="booking-subtitle">Completa el formulario y te contactaremos por WhatsApp</p>

      <form class="booking-form" id="booking-form" onsubmit="return false;">
        <div class="booking-grid">
          <div class="form-group">
            <input type="text" name="name" id="name" class="form-input" placeholder=" " required />
            <label for="name" class="form-label">Nombre completo</label>
          </div>
          <div class="form-group">
            <input type="email" name="email" id="email" class="form-input" placeholder=" " required />
            <label for="email" class="form-label">Correo electronico</label>
          </div>
          <div class="form-group">
            <input type="tel" name="phone" id="phone" class="form-input" placeholder=" " required />
            <label for="phone" class="form-label">Telefono</label>
          </div>
          <div class="form-group">
            <input type="date" name="date" id="date" class="form-input" />
            <label for="date" class="form-label">Fecha preferida</label>
          </div>
          <div class="form-group form-group--full">
            <textarea name="message" id="message" rows="4" class="form-input form-textarea" placeholder=" "></textarea>
            <label for="message" class="form-label">Mensaje adicional (opcional)</label>
          </div>
        </div>
        <button type="submit" class="booking-submit" id="booking-submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Enviar por WhatsApp
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .booking-section {
    padding: 5rem 1.5rem;
    background-color: #f9f9ff;
  }
  .booking-container {
    max-width: 800px;
    margin: 0 auto;
  }
  .booking-card {
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 3rem 2.5rem;
    box-shadow: 0 4px 24px rgba(0, 66, 104, 0.06);
  }
  .booking-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #001d32;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .booking-subtitle {
    text-align: center;
    font-size: 0.9375rem;
    color: #717880;
    margin-bottom: 2rem;
  }
  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    position: relative;
  }
  .form-group--full {
    grid-column: 1 / -1;
  }

  .form-input {
    width: 100%;
    padding: 0.875rem 0;
    font-size: 1rem;
    font-family: inherit;
    color: #111c2c;
    background: transparent;
    border: none;
    border-bottom: 1px solid #c1c7d0;
    border-radius: 0;
    outline: none;
    transition: border-color 0.25s ease;
  }
  .form-input:focus {
    border-bottom-color: #004268;
  }
  .form-textarea {
    resize: vertical;
    min-height: 60px;
  }

  .form-label {
    position: absolute;
    left: 0;
    top: 0.875rem;
    font-size: 1rem;
    color: #717880;
    pointer-events: none;
    transition: all 0.2s ease;
  }
  .form-input:focus ~ .form-label,
  .form-input:not(:placeholder-shown) ~ .form-label {
    top: -0.625rem;
    font-size: 0.75rem;
    color: #004268;
    font-weight: 500;
  }

  .booking-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 280px;
    margin: 2.5rem auto 0;
    padding: 0 2rem;
    height: 48px;
    background-color: #25D366;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }
  .booking-submit:hover {
    background-color: #1ebe57;
    transform: translateY(-1px);
  }
  .booking-submit:focus-visible {
    outline: 2px solid #25D366;
    outline-offset: 2px;
  }

  @media (max-width: 600px) {
    .booking-card {
      padding: 2rem 1.25rem;
    }
    .booking-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const submitBtn = document.getElementById('booking-submit') as HTMLButtonElement;

  const WHATSAPP_NUMBER = '50243036016';

  function formatDate(dateStr: string): string {
    if (!dateStr) return 'No especificada';
    const [y, m, d] = dateStr.split('-');
    return `${d}/${m}/${y}`;
  }

  submitBtn.addEventListener('click', () => {
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const date = (document.getElementById('date') as HTMLInputElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    const text = [
      `Hola, soy *${name}*.`,
      `Me gustaria solicitar una cita medica en el Hospital Sancti Spiritus.`,
      ``,
      `📧 Email: ${email}`,
      `📞 Telefono: ${phone}`,
      `📅 Fecha preferida: ${formatDate(date)}`,
    ];

    if (message) {
      text.push(`💬 Mensaje adicional: ${message}`);
    }

    const encoded = encodeURIComponent(text.join('\n'));
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encoded}`, '_blank');
  });
</script>
