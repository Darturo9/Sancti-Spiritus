---
const testimonials = [
  {
    name: 'Maria Elena Pop',
    role: 'Paciente',
    quote: 'La atencion que recibi fue excepcional. Desde el primer momento me senti en buenas manos. El equipo medico no solo es profesional, sino tambien muy humano.',
    stars: 5,
  },
  {
    name: 'Roberto Casal',
    role: 'Paciente',
    quote: 'Como padre de familia, buscaba seguridad y rapidez. Encontre ambas en este hospital. Mis hijos fueron atendidos con una paciencia y carino que nunca olvidare.',
    stars: 5,
  },
  {
    name: 'Sofia Fernandez',
    role: 'Paciente',
    quote: 'Despues de mi cirugia, la rehabilitacion fue fundamental. Las instalaciones son de primer nivel y el personal siempre estuvo pendiente de mi evolucion.',
    stars: 4,
  },
  {
    name: 'Carlos Mendoza',
    role: 'Paciente Recuperado',
    quote: 'Vine desde un municipio lejano por recomendacion y valio cada kilometro. El trato es completamente diferente: te escuchan, te explican y te acompanan en todo el proceso.',
    stars: 5,
  },
];

const initials = (name: string) => name.split(' ').filter((_, i, a) => i === 0 || i === a.length - 1).map(w => w[0]).join('');
---

<section class="reviews-section" id="testimonios">
  <div class="reviews-container">
    <h2 class="reviews-heading">Lo Que Dicen Nuestros Pacientes</h2>
    <p class="reviews-subtitle">Historias reales de personas que confiaron en nosotros</p>

    <div class="carousel-viewport" id="reviews-viewport">
      <div class="carousel-track" id="reviews-track">
        <!-- Clones at start: last 2 cards for left-side neighbors -->
        {testimonials.slice(-2).map((t, i) => (
          <div class="review-card clone">
            <div class="review-stars">
              {Array.from({ length: 5 }).map((_, s) => (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill={s < t.stars ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" class={s < t.stars ? 'star-filled' : 'star-empty'}>
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <p class="review-text">{t.quote}</p>
            <div class="review-author">
              <div class="review-avatar">{initials(t.name)}</div>
              <figcaption>
                <strong class="review-name">{t.name}</strong>
                <span class="review-role">{t.role}</span>
              </figcaption>
            </div>
          </div>
        ))}

        <!-- Original cards -->
        {testimonials.map((t, i) => (
          <div class={`review-card ${i === 0 ? 'active' : ''}`} data-index={i}>
            <div class="review-stars">
              {Array.from({ length: 5 }).map((_, s) => (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill={s < t.stars ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" class={s < t.stars ? 'star-filled' : 'star-empty'}>
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <p class="review-text">{t.quote}</p>
            <div class="review-author">
              <div class="review-avatar">{initials(t.name)}</div>
              <figcaption>
                <strong class="review-name">{t.name}</strong>
                <span class="review-role">{t.role}</span>
              </figcaption>
            </div>
          </div>
        ))}

        <!-- Clones at end: first 2 cards for right-side neighbors -->
        {testimonials.slice(0, 2).map((t, i) => (
          <div class="review-card clone">
            <div class="review-stars">
              {Array.from({ length: 5 }).map((_, s) => (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill={s < t.stars ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" class={s < t.stars ? 'star-filled' : 'star-empty'}>
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <p class="review-text">{t.quote}</p>
            <div class="review-author">
              <div class="review-avatar">{initials(t.name)}</div>
              <figcaption>
                <strong class="review-name">{t.name}</strong>
                <span class="review-role">{t.role}</span>
              </figcaption>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="carousel-dots" id="reviews-dots">
      {testimonials.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Testimonio ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 5rem 1.5rem;
    background-color: #ffffff;
    overflow: hidden;
  }
  .reviews-container {
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
  }
  .reviews-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #001d32;
    margin-bottom: 0.5rem;
  }
  .reviews-subtitle {
    font-size: 1.0625rem;
    color: #717880;
    margin-bottom: 3rem;
  }

  .carousel-viewport {
    overflow: hidden;
    position: relative;
    min-height: 300px;
  }
  .carousel-track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .review-card {
    flex-shrink: 0;
    background-color: #f9f9ff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(0, 66, 104, 0.06);
    transition: background-color 0.5s ease, box-shadow 0.5s ease, opacity 0.5s ease, transform 0.5s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    opacity: 0.55;
    transform: scale(0.94);
  }
  .review-card.clone {
    pointer-events: none;
  }
  .review-card:hover {
    opacity: 0.75;
    transform: scale(0.96);
  }
  .review-card.active {
    opacity: 1;
    transform: scale(1);
    background-color: #001d32;
    color: #ffffff;
    box-shadow: 0 8px 40px rgba(0, 66, 104, 0.20);
    cursor: default;
  }

  .review-stars {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.25rem;
  }
  .star-filled { color: #f59e0b; }
  .star-empty { color: #d1d5db; }
  .review-card.active .star-empty {
    color: rgba(255,255,255,0.25);
  }

  .review-text {
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-bottom: 1.5rem;
    font-style: italic;
    flex: 1;
  }
  .review-card.active .review-text {
    color: rgba(255,255,255,0.9);
  }
  .review-card:not(.active) .review-text {
    color: #41474f;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .review-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    background-color: #346285;
    color: #ffffff;
    flex-shrink: 0;
    transition: background-color 0.5s ease;
  }
  .review-card.active .review-avatar {
    background-color: #004268;
  }
  .review-name {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .review-card:not(.active) .review-name {
    color: #001d32;
  }
  .review-role {
    display: block;
    font-size: 0.8125rem;
    margin-top: 0.125rem;
  }
  .review-card.active .review-role {
    color: rgba(255,255,255,0.75);
  }
  .review-card:not(.active) .review-role {
    color: #717880;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 2rem;
  }
  .dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #c1c7d0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.3s ease, background-color 0.3s ease;
    position: relative;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background-color: transparent;
    transition: background-color 0.3s ease;
  }
  .dot.active {
    border-color: #004268;
  }
  .dot.active::after {
    background-color: #004268;
  }
  .dot:hover {
    border-color: #004268;
  }

  @media (min-width: 1024px) {
    .review-card {
      width: 50%;
      padding: 2.5rem;
    }
  }

  @media (max-width: 1023px) {
    .review-card {
      width: calc((100vw - 1.5rem - 1.5rem) * 0.78);
      padding: 1.5rem;
    }
    .review-text {
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 639px) {
    .review-card {
      width: calc(100vw - 3rem);
      padding: 1.25rem;
    }
    .carousel-track {
      gap: 1rem;
    }
    .carousel-dots {
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  const CLONES_LEFT = 2;
  const ORIGINAL_COUNT = 4;
  const TOTAL = CLONES_LEFT + ORIGINAL_COUNT + 2; // 8

  const viewport = document.getElementById('reviews-viewport') as HTMLDivElement;
  const track = document.getElementById('reviews-track') as HTMLDivElement;
  const allCards = track.querySelectorAll<HTMLDivElement>('.review-card');
  const dots = document.querySelectorAll<HTMLButtonElement>('#reviews-dots .dot');

  let currentTrackIdx = CLONES_LEFT; // starts at first original
  let interval: ReturnType<typeof setInterval>;

  function centerTrackCard(trackIdx: number) {
    const card = allCards[trackIdx];
    if (!card) return;

    const cardRect = card.getBoundingClientRect();
    const trackRect = track.getBoundingClientRect();
    const viewportWidth = viewport.offsetWidth;
    const cardCenter = cardRect.left - trackRect.left + cardRect.width / 2;
    const offset = viewportWidth / 2 - cardCenter;

    track.style.transform = `translateX(${offset}px)`;
  }

  function logicalIndex(trackIdx: number) {
    return ((trackIdx - CLONES_LEFT) % ORIGINAL_COUNT + ORIGINAL_COUNT) % ORIGINAL_COUNT;
  }

  function updateActive(logical: number) {
    allCards.forEach(c => c.classList.remove('active'));
    const originals = track.querySelectorAll<HTMLDivElement>('.review-card:not(.clone)');
    originals.forEach(c => {
      const idx = parseInt(c.getAttribute('data-index') || '0');
      if (idx === logical) c.classList.add('active');
    });
    dots.forEach((d, i) => d.classList.toggle('active', i === logical));
  }

  function goTo(trackIdx: number, animate: boolean = true) {
    if (!animate) {
      track.style.transition = 'none';
    }
    centerTrackCard(trackIdx);
    currentTrackIdx = trackIdx;
    updateActive(logicalIndex(trackIdx));

    if (!animate) {
      void track.offsetHeight; // force reflow
      track.style.transition = '';
    }
  }

  function nextReview() {
    goTo(currentTrackIdx + 1);
  }

  track.addEventListener('transitionend', () => {
    if (currentTrackIdx >= CLONES_LEFT + ORIGINAL_COUNT) {
      goTo(currentTrackIdx - ORIGINAL_COUNT, false);
    } else if (currentTrackIdx < CLONES_LEFT) {
      goTo(currentTrackIdx + ORIGINAL_COUNT, false);
    }
  });

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const logical = parseInt(dot.getAttribute('data-index') || '0');
      goTo(CLONES_LEFT + logical);
      clearInterval(interval);
      interval = setInterval(nextReview, 5000);
    });
  });

  const originals = track.querySelectorAll<HTMLDivElement>('.review-card:not(.clone)');
  originals.forEach(card => {
    card.addEventListener('click', () => {
      const logical = parseInt(card.getAttribute('data-index') || '0');
      if (logical === logicalIndex(currentTrackIdx)) return;
      goTo(CLONES_LEFT + logical);
      clearInterval(interval);
      interval = setInterval(nextReview, 5000);
    });
  });

  goTo(CLONES_LEFT, false);
  interval = setInterval(nextReview, 5000);

  window.addEventListener('resize', () => {
    track.style.transition = 'none';
    centerTrackCard(currentTrackIdx);
    void track.offsetHeight;
    track.style.transition = '';
  });
</script>
