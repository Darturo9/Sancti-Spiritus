  .hero-dots {
    position: absolute;
    top: 50%;
    right: 1.5rem;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    z-index: 10;
  }
  .dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.7);
    background: transparent;
    cursor: pointer;
    padding: 0;
    touch-action: manipulation;
    margin: 0;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    position: relative;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background-color: transparent;
    transition: background-color 0.3s ease;
  }
  .dot.active::after { background-color: #ffffff; }
  .dot:hover { border-color: #ffffff; }

  @media (max-width: 767px) {
    .hero-section {
      height: 100vh;
      min-height: 550px;
    }
    .hero-overlay {
      background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 40%);
