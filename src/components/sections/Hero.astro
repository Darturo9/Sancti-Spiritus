      padding-top: 0;
      padding-bottom: 2rem;
    }
    .hero-title { font-size: 1.75rem; }
    .hero-subtitle { font-size: 1rem; }
    .hero-dots {
      top: 8rem;
      bottom: auto;
      right: auto;
      left: 50%;
      margin-left: -48px;
      transform: none;
      flex-direction: row;
    }
  }

  .hero-entrance {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    transition-delay: var(--delay, 0s);
  }
  .hero-entrance.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-entrance {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .hero-carousel .slide {
      transform: none !important;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll('.hero-carousel .slide');
  const dots = document.querySelectorAll('#hero-dots .dot');
  const words = document.querySelectorAll('.animated-word');
  let currentSlide = 0;
  let interval: ReturnType<typeof setInterval>;

  function showSlide(index: number) {
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    words.forEach(w => w.classList.remove('active'));
    slides[index].classList.add('active');
    dots[index].classList.add('active');
    words[index].classList.add('active');
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % slides.length);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.getAttribute('data-index') || '0');
      showSlide(idx);
      clearInterval(interval);
      interval = setInterval(nextSlide, 5000);
    });
  });

  interval = setInterval(nextSlide, 5000);

  requestAnimationFrame(() => {
    document.querySelectorAll('.hero-entrance').forEach(el => el.classList.add('visible'));
  });

  const hero = document.querySelector('.hero-section') as HTMLElement;
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const isMobile = window.matchMedia('(max-width: 767px)');

  if (!mediaQuery.matches && !isMobile.matches) {
    window.addEventListener('scroll', () => {
      const rect = hero.getBoundingClientRect();
      if (rect.bottom > 0) {
        const progress = Math.max(-1, Math.min(1, -rect.top / rect.height));
        const activeSlide = slides[currentSlide] as HTMLElement;
        if (activeSlide) {
          activeSlide.style.transform = `translateY(${progress * 50}px)`;
        }
      }
    }, { passive: true });
  }
</script>
