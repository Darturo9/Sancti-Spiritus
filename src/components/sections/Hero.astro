<section class="hero-section" id="hero">
  <div class="hero-carousel">
    <div class="slide active">
      <img
        src="/images/hero-1.jpg"
        alt="Fachada principal del Hospital Clinico Quirurgico Sancti Spiritus"
        class="slide-img"
        loading="eager"
      />
    </div>
    <div class="slide">
      <img
        src="/images/hero-2.jpg"
        alt="Areas de atencion y consultorios del Hospital Sancti Spiritus"
        class="slide-img"
        loading="lazy"
      />
    </div>
    <div class="slide">
      <img
        src="/images/hero-3.jpg"
        alt="Equipo y tecnologia medica del Hospital Sancti Spiritus"
        class="slide-img"
        loading="lazy"
      />
    </div>
  </div>

  <div class="hero-overlay">
    <h1 class="hero-title">
      Cuidamos tu
      <span class="animated-text">
        <span class="animated-word active">salud</span>
        <span class="animated-word">familia</span>
        <span class="animated-word">futuro</span>
      </span>
    </h1>
    <p class="hero-subtitle">Atencion medica de excelencia con calidez humana en San Cristobal Verapaz. Mas de 20 años al servicio de la comunidad.</p>
    <div class="hero-actions">
      <a href="#about" class="hero-btn">Conocenos</a>
      <a href="tel:79504789" class="hero-phone">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        7950-4789
      </a>
    </div>
  </div>

  <div class="hero-dots" id="hero-dots">
    <button class="dot active" data-index="0" aria-label="Slide 1"></button>
    <button class="dot" data-index="1" aria-label="Slide 2"></button>
    <button class="dot" data-index="2" aria-label="Slide 3"></button>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
    min-height: 650px;
    max-height: 900px;
    overflow: hidden;
    background-color: #000b36;
  }
  .hero-carousel {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }
  .slide.active {
    opacity: 1;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,66,104,0.88) 0%, rgba(0,66,104,0.55) 50%, rgba(0,66,104,0.2) 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.5rem;
    padding-top: 108px;
  }
  .hero-title {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    max-width: 700px;
    margin-bottom: 1.25rem;
  }
  .animated-text {
    display: inline-block;
    position: relative;
    min-width: 260px;
    vertical-align: bottom;
    height: 1.15em;
    overflow: hidden;
  }
  .animated-word {
    display: block;
    color: #95ccff;
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transform: translateY(0.5em);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .animated-word.active {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    max-width: 560px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 2rem;
    height: 48px;
    background-color: #ffffff;
    color: #004268;
    font-weight: 600;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 0;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }
  .hero-btn:hover { background-color: #e7eeff; transform: translateY(-1px); }
  .hero-phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .hero-phone:hover { opacity: 0.8; }
  .hero-dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.75rem;
    z-index: 2;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.7);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  .dot.active { background-color: #ffffff; border-color: #ffffff; }
  .dot:hover { border-color: #ffffff; }

  @media (max-width: 767px) {
    .hero-section {
      height: 85vh;
      min-height: 550px;
    }
    .hero-overlay {
      background: linear-gradient(to top, rgba(0,66,104,0.92), rgba(0,66,104,0.4));
      justify-content: flex-end;
      padding-bottom: 4rem;
    }
    .hero-title { font-size: 1.75rem; }
    .hero-subtitle { font-size: 1rem; }
  }
</style>

<script>
  const slides = document.querySelectorAll('.hero-carousel .slide');
  const dots = document.querySelectorAll('#hero-dots .dot');
  const words = document.querySelectorAll('.animated-word');
  let currentSlide = 0;
  let interval: ReturnType<typeof setInterval>;

  function showSlide(index: number) {
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    words.forEach(w => w.classList.remove('active'));
    slides[index].classList.add('active');
    dots[index].classList.add('active');
    words[index].classList.add('active');
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % slides.length);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.getAttribute('data-index') || '0');
      showSlide(idx);
      clearInterval(interval);
      interval = setInterval(nextSlide, 5000);
    });
  });

  interval = setInterval(nextSlide, 5000);
</script>
