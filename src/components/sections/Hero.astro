    transition: opacity 0.4s ease, transform 0.4s ease;
    will-change: opacity, transform;
  }
  .animated-word.active {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
