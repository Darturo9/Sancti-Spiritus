---
const mainServices = [
  {
    title: 'Emergencias 24/7',
    description: 'Atención inmediata a todo tipo de emergencias médicas con personal capacitado y equipamiento de respuesta rápida.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  },
  {
    title: 'Laboratorio Clínico',
    description: 'Pruebas de hematología completa, embarazo, Helicobacter pylori, tipo de sangre, hormonas y más. Disponible 24 horas.',
    icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  },
  {
    title: 'Cirugía',
    description: 'Quirófano equipado para cirugías curativas, de urgencia, reparadoras y programadas con especialistas certificados.',
    icon: 'M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  },
  {
    title: 'Maternidad',
    description: 'Atención obstétrica integral, sala de partos, área neonatal y unidad intermedia para el cuidado de madre y bebé.',
    icon: 'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
  },
  {
    title: 'Hospitalización',
    description: 'Habitaciones sencillas, estándar y VIP con atención especializada, enfermería 24/7, monitoreo médico y alimentación.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    title: 'Consulta Externa',
    description: 'Atención médica general, ginecología y pediatría con médicos de planta. Horario: 8:00 AM a 8:00 PM.',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  },
];

const moreServices = [
  {
    title: 'Rayos X',
    description: 'Diagnóstico por imágenes con tecnología digital para evaluación ósea, torácica y estudios complementarios.',
    icon: 'M21 12a9 9 0 11-18 0 9 9 0 0118 0z M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9 10a1 1 0 000 2h.01a1 1 0 000-2H9zm6 0a1 1 0 000 2h.01a1 1 0 000-2H15zM9 15c.85.63 1.885 1 3 1s2.15-.37 3-1',
  },
  {
    title: 'Ultrasonidos',
    description: 'Ecografías y estudios de imagen para evaluación abdominal, obstétrica, pélvica y de tejidos blandos.',
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  },
  {
    title: 'Área Neonatal',
    description: 'Cuidados especializados para recién nacidos con monitoreo constante y personal de enfermería capacitado.',
    icon: 'M7 2h10v4l3 3v10a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2z',
  },
  {
    title: 'Unidad Intermedia',
    description: 'Atención de pacientes que requieren monitoreo continuo sin necesidad de cuidados intensivos.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Farmacia Interna',
    description: 'Medicamentos disponibles las 24 horas para pacientes hospitalizados y de consulta externa con receta médica.',
    icon: 'M9 2h6v4l3 3v10a2 2 0 01-2 2H8a2 2 0 01-2-2V7l3-3z M9 2v4h6V2',
  },
  {
    title: 'Especialidades Médicas',
    description: 'Medicina general, ginecología, pediatría, urología y otorrinolaringología con especialistas certificados.',
    icon: 'M12 2a7 7 0 017 7c0 5.25-7 13-7 13S5 14.25 5 9a7 7 0 017-7z M12 9a2 2 0 100-4 2 2 0 000 4z',
  },
];
---

<section class="services-section" id="services">
  <div class="services-container">
    <h2 class="services-heading" data-animate-child style="--delay: 0s">Nuestros Servicios</h2>
    <p class="services-subtitle" data-animate-child style="--delay: 0.08s">Atencion medica integral para toda la familia, disponible las 24 horas</p>

    <div class="services-grid">
      {mainServices.slice(0, 4).map((service, i) => (
        <div class="service-card" data-animate-child style={`--delay: ${0.15 + i * 0.07}s`}>
          <div class="service-icon-wrapper">
            <svg class="service-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={service.icon} />
            </svg>
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.description}</p>
        </div>
      ))}
      {mainServices.slice(4).map(service => (
        <div class="service-card desktop-only">
          <div class="service-icon-wrapper">
            <svg class="service-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={service.icon} />
            </svg>
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.description}</p>
        </div>
      ))}
    </div>

    <div class="services-more" id="services-more">
      <div class="services-grid">
        {mainServices.slice(4).map(service => (
          <div class="service-card service-card--secondary mobile-only">
            <div class="service-icon-wrapper service-icon-wrapper--small">
              <svg class="service-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={service.icon} />
              </svg>
            </div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-desc">{service.description}</p>
          </div>
        ))}
        {moreServices.map(service => (
          <div class="service-card service-card--secondary">
            <div class="service-icon-wrapper service-icon-wrapper--small">
              <svg class="service-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={service.icon} />
              </svg>
            </div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-desc">{service.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="services-toggle">
      <button class="toggle-btn" id="services-toggle-btn" aria-expanded="false">
        <span class="toggle-text">Ver más servicios</span>
        <svg class="toggle-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 5rem 1.5rem;
    background-color: #f9f9ff;
  }
  .services-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  .services-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #001d32;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .services-subtitle {
    text-align: center;
    font-size: 1.0625rem;
    color: #717880;
    margin-bottom: 3rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .service-card {
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 2px 16px rgba(0, 66, 104, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid #e7eeff;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 66, 104, 0.10);
  }
  .service-card--secondary {
    background-color: #f0f3ff;
    border-color: #d8e3fa;
  }

  .service-icon-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background-color: #004268;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }
  .service-icon-wrapper--small {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: #346285;
  }
  .service-icon {
    color: #ffffff;
  }

  .service-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #001d32;
    margin-bottom: 0.5rem;
  }
  .service-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #41474f;
    margin: 0;
  }

  .services-more {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), margin-top 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 0;
  }
  .services-more.open {
    max-height: 2000px;
    margin-top: 1.5rem;
  }
  .services-more .services-grid {
    padding-top: 0;
  }

  .services-toggle {
    text-align: center;
    margin-top: 2rem;
  }
  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    background-color: #ffffff;
    color: #004268;
    border: 1.5px solid #004268;
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .toggle-btn:hover {
    background-color: #004268;
    color: #ffffff;
  }
  .toggle-btn:focus-visible {
    outline: 2px solid #004268;
    outline-offset: 2px;
  }
  .toggle-arrow {
    transition: transform 0.3s ease;
  }
  .toggle-btn[aria-expanded="true"] .toggle-arrow {
    transform: rotate(180deg);
  }

  .desktop-only { display: none; }
  .mobile-only { display: none; }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .desktop-only { display: flex; }
  }

  @media (max-width: 639px) {
    .mobile-only { display: flex; }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('services-toggle-btn') as HTMLButtonElement;
  const morePanel = document.getElementById('services-more') as HTMLDivElement;
  const toggleText = toggleBtn?.querySelector('.toggle-text') as HTMLSpanElement;

  toggleBtn?.addEventListener('click', () => {
    const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isOpen));
    morePanel.classList.toggle('open');
    toggleText.textContent = isOpen ? 'Ver más servicios' : 'Mostrar menos';
  });
</script>
