---
export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image = 'https://res.cloudinary.com/dao9ur00t/image/upload/v1782251248/logo_byttb2.webp' } = Astro.props;
const fullTitle = `${title} | Hospital Sancti Spiritus`;
const fullDescription = description || 'Hospital Clínico Quirúrgico Sancti Spiritus — Atención de excelencia en San Cristobal Verapaz, Guatemala.';
import '../styles/global.css';
---

<!DOCTYPE html>
<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={fullDescription} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_GT" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href="https://res.cloudinary.com/dao9ur00t/image/upload/v1782251247/hero-1_l6n8x6.webp" fetchpriority="high" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <slot />
  </body>
</html>
